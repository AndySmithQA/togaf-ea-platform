# Provide an OpenAI-compatible API key to enable live LLM document generation.
# When OPENAI_API_KEY is unset, the platform falls back to deterministic
# template-based generation so the mock-up still works end-to-end.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Cursor API key for the Cursor Cloud Agents API (https://api.cursor.com/v1).
# This is NOT used by the chat.completions document-generation agent; it is
# reserved for a future backend that delegates document generation to
# Cursor Cloud Agents (background coding agents).
CURSOR_API_KEY=
