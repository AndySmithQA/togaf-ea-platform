{
  "name": "togaf-ea-platform",
  "version": "0.2.0",
  "description": "Spec-Kit-style toolkit for TOGAF 10 Enterprise Architecture: a CLI that installs slash commands and an Architecture Repository skeleton into any folder, plus a Next.js dashboard that points at the active folder.",
  "bin": {
    "togaf": "./cli/togaf.mjs"
  },
  "files": [
    "cli/",
    "commands/",
    "skeleton/",
    "templates/",
    "examples/",
    "src/",
    "public/",
    "next.config.ts",
    "tailwind.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "components.json",
    "README.md",
    "INSTALL.md"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "togaf": "node ./cli/togaf.mjs"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "openai": "^4.77.0",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.469.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "tailwindcss-animate": "^1.0.7"
  }
}
